# ─────────────────────────────────────────────────────────────────────────────
# Qatu API — Environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust for your environment.
# Docker Compose reads `.env` automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE & SUPABASE — THREE DEPLOYMENT MODES
# ─────────────────────────────────────────────────────────────────────────────
# Pick the pair of values matching your setup. Container names (`postgres`,
# `gotrue`) resolve via the shared `qatu-net` Docker network.
#
#   Mode A — Supabase CLI on host (npx supabase start):
#     DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
#     SUPABASE_URL=http://host.docker.internal:54321
#     (Linux hosts: add `extra_hosts: ["host.docker.internal:host-gateway"]`
#      to the `api` service in docker-compose.dev.yml)
#
#   Mode B — Fully containerized (default for dev + lab, see SP-16):
#     DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
#     SUPABASE_URL=http://gotrue:9999
#
#   Mode C — Supabase Cloud (production):
#     DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
#     SUPABASE_URL=https://<project>.supabase.co
# ─────────────────────────────────────────────────────────────────────────────

# Current value: Mode A-auth + Mode B-db (default for `docker-compose.dev.yml`).
# Auth runs via Supabase CLI on host (`npx supabase start`); DB runs in the
# `postgres` container. If you want fully-containerized auth, see the "Advanced:
# Gotrue in compose" section below.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_URL MUST be the same Supabase instance the frontend uses for social
# login: POST /v1/auth/oauth/exchange verifies the access token via this
# instance's auth API (supabase.auth.getUser).

# ── Database Seeding ──
# In development (docker-compose.dev.yml), seeds run automatically after
# migrations. In production, set to `true` only for the FIRST deploy against
# an empty database; leave `false` for subsequent deploys.
RUN_SEEDS=false

# ── Supabase Auth ──
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage Configuration (ADR-010 / US-04)
# Public storage URL returned to the client browser to resolve avatars.
# Must be reachable from the client's browser, while SUPABASE_URL is for server-side calls.
SUPABASE_STORAGE_PUBLIC_URL=http://localhost:54321/storage/v1/object/public
SUPABASE_STORAGE_BUCKET=avatars

# Secret used to verify HS256 JWT tokens issued by Supabase Auth
JWT_SECRET=your-jwt-secret

# ── RabbitMQ (ADR-014) ──
# Production MUST use amqps:// (TLS). Never commit a real broker URL.
RABBITMQ_URL=amqp://qatu:qatu_dev_password@rabbitmq:5672
# Off by default: checkout still works without a broker; events wait in `outbox_events`.
# Enable in staging/production (and locally to test notifications being created).
RABBITMQ_ENABLED=false
RABBITMQ_EXCHANGE=qatu.events
RABBITMQ_NOTIFICATIONS_QUEUE=qatu.notifications
RABBITMQ_DLX=qatu.dlx
RABBITMQ_DLQ=qatu.notifications.dlq
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=3

# ── CORS ──
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth configuration via Google (social login — US-03).
# Issue the URL/secret from Google Cloud ↔ Supabase consent setup; these are
# consumed by the frontend OAuth flow. The backend only validates the
# resulting Supabase session tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Dev tools (pgAdmin — dev-tools override only) ──
# pgAdmin v9 requires a password of at least 6 characters.
PGADMIN_EMAIL=admin@qatu.com
PGADMIN_PASSWORD=admin123

# ── Postgres (docker-compose only) ──
# Postgres container credentials (used by docker-compose.yml).
# Change these in production deployments. Defaults are safe for local dev only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ─────────────────────────────────────────────────────────────────────────────
# ADVANCED: Gotrue in compose (deferred to a future iteration)
# ─────────────────────────────────────────────────────────────────────────────
# If you want fully-containerized auth (no Supabase CLI on host), you must:
#   1. Replace `postgres:17-alpine` with `supabase/postgres:17.11.0.018` in
#      docker-compose.yml (it ships the full auth schema that Gotrue expects).
#   2. Add a `gotrue` service to docker-compose.dev.yml:
#        gotrue:
#          image: supabase/gotrue:v2.198.0
#          environment:
#            GOTRUE_DB_DRIVER: postgres
#            GOTRUE_DB_DATABASE_URL: postgresql://postgres:postgres@postgres:5432/postgres
#            GOTRUE_SITE_URL: http://localhost:5173
#            GOTRUE_JWT_SECRET: ${JWT_SECRET}
#            GOTRUE_JWT_EXP: 3600
#            GOTRUE_DISABLE_SIGNUP: 'false'
#            GOTRUE_MAILER_AUTOCONFIRM: 'true'
#          depends_on:
#            postgres:
#              condition: service_healthy
#          networks:
#            - qatu-net
#          expose:
#            - '9999'
#   3. Point SUPABASE_URL to `http://gotrue:9999`.
#
# This is OUT OF SCOPE for the DevOps Lab Week 2 deliverable (which specifies
# 4 containers: api, client, postgres, rabbitmq). Mode A (Supabase CLI on host)
# is the recommended auth path for dev.
