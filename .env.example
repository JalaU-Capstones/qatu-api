# Application Runtime Environment (development | test | production)
NODE_ENV=development

# HTTP Server Port
PORT=3000

# Application PostgreSQL Database Connection URI (Sequelize persistence)
DATABASE_URL=postgresql://qatu:qatu_dev_password@localhost:5432/qatu_dev

# Supabase Project URL (Auth & Storage API endpoint)
SUPABASE_URL=http://localhost:54321

# Supabase Anonymous Public Key (safe for client-side/standard auth operations)
SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (privileged admin key — server-side only, NEVER expose to clients or logs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to verify HS256 JWT tokens issued by Supabase Auth
JWT_SECRET=your-jwt-secret

# RabbitMQ Broker Connection URI for asynchronous domain events
# Production MUST use amqps:// (TLS). Never commit a real broker URL.
RABBITMQ_URL=amqp://qatu:qatu_dev_password@localhost:5672

# Transactional outbox worker + notification consumer (ADR-014).
# Off by default: checkout still works without a broker, events wait in `outbox_events`.
# Set it to true in staging/production (and locally to see notifications being created).
RABBITMQ_ENABLED=false
# Optional. Applied only when RABBITMQ_URL has no vhost of its own. Use a different vhost per environment.
# RABBITMQ_VHOST=qatu-dev
RABBITMQ_EXCHANGE=qatu.events
RABBITMQ_NOTIFICATIONS_QUEUE=qatu.notifications
RABBITMQ_DLX=qatu.dlx
RABBITMQ_DLQ=qatu.notifications.dlq
# 2000 for development; 5000 recommended in production.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=3

# Primary Frontend Origin and Comma-Separated Allowed CORS Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth configuration via Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=